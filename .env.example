# ==============================================================================
# ClearData Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# Security & JWT Auth
SECRET_KEY=cleardata-dev-insecure-secret-key-replace-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# By default (when DATABASE_URL is omitted/commented), ClearData uses local SQLite (apps/api/cleardata.db).
# For local PostgreSQL, uncomment and adjust:
# DATABASE_URL=postgresql://cleardata:cleardata_dev_password@localhost:5432/cleardata
# Note: Docker Compose sets its own internal DATABASE_URL and REDIS_URL automatically.
POSTGRES_USER=cleardata
POSTGRES_PASSWORD=cleardata_dev_password
POSTGRES_DB=cleardata
POSTGRES_PORT=5432

# Redis (Job Queue & Realtime Cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# When true, jobs run in-process synchronously (required on native Windows without WSL)
JOBS_INLINE=true

# Storage Service
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# AI Interpretation & Summary Service
# Options: mock, openai, anthropic, gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend (Next.js) Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
