# ==============================================================================
# ClearData Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# Security & JWT Auth
SECRET_KEY=cleardata-dev-insecure-secret-key-replace-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
# In Docker compose, host is 'postgres'. Locally outside Docker, host is 'localhost'.
POSTGRES_USER=cleardata
POSTGRES_PASSWORD=cleardata_dev_password
POSTGRES_DB=cleardata
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cleardata:cleardata_dev_password@postgres:5432/cleardata

# Redis (Job Queue & Realtime Cache)
# In Docker compose, host is 'redis'. Locally outside Docker, host is 'localhost'.
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage Service
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# AI Interpretation & Summary Service
# Options: mock, openai, anthropic, gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend (Next.js) Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
